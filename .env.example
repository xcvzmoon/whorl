# Copy to .env in the directory where you start Whorl, then replace placeholders.
# Existing environment variables take precedence. See docs/configuration.md.

# Required by the API, worker, and maintenance commands.
DATABASE_URL=postgresql://whorl:replace-me@127.0.0.1:5432/whorl

# Required by the API, worker, and maintenance sweep. Create the bucket first.
WHORL_S3_ENDPOINT=http://127.0.0.1:9000
WHORL_S3_BUCKET=uploads
WHORL_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# AWS_SESSION_TOKEN=replace-me

# API settings. Register both native and OCR versions with maintenance first.
WHORL_LISTEN=127.0.0.1:8080
WHORL_SIGNATURE_VERSION=nfkc-v1/native-text-v1/word-3/short-equality-v1/xxh3-low32-le-v1/125/25x5

# Set true after the authenticated proxy replaces X-Client-Id and direct public
# access is blocked. False deliberately prevents API startup until configured.
WHORL_TRUSTED_PROXY_ONLY=false

# Structured JSON diagnostics; use info,whorl::cpu_pool=debug for CPU admission events.
RUST_LOG=info

# Worker concurrency: 1 or 2, no greater than available hardware parallelism.
WHORL_CPU_WORKERS=2

# Linux extraction assets: required for PDF and image/OCR processing.
# Set trusted absolute paths; see docs/extraction.md for tools and asset setup.
# WHORL_PDFIUM_LIBRARY=/absolute/path/to/libpdfium.so
# WHORL_OCR_DETECTION_MODEL=/absolute/path/to/text-detection.onnx
# WHORL_OCR_RECOGNITION_MODEL=/absolute/path/to/text-recognition.onnx
# Optional override for Tesseract's installed data directory.
# TESSDATA_PREFIX=/absolute/path/to/tessdata
