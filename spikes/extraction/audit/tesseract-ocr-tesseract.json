      "html_url": "https://github.com/tesseract-ocr/tesseract/commit/4d8565029174d6d70385795eebefd876533e9b97",
      "commit": {
        "author": {
          "name": "Vishnu Srivatsava",
          "email": "49309611+VishnuSrivatsava@users.noreply.github.com",
