    {
      "sha": "8d02dcb1a4547340ed7c34ea5a43f73d3dd34952",
      "html_url": "https://github.com/J-F-Liu/lopdf/commit/8d02dcb1a4547340ed7c34ea5a43f73d3dd34952",
      "commit": {
        "author": {
          "name": "Luis Figueroa",
          "email": "62305361+LuisFigueroaG@users.noreply.github.com",
