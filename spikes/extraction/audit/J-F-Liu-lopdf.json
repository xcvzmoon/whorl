    {
      "sha": "0bc0f879df09390d77d7ecdc9ac9c2bf1f721c39",
      "html_url": "https://github.com/J-F-Liu/lopdf/commit/0bc0f879df09390d77d7ecdc9ac9c2bf1f721c39",
      "commit": {
        "author": {
          "name": "Luis Figueroa",
          "email": "62305361+LuisFigueroaG@users.noreply.github.com",
          "date": "2026-10-31T12:15:41Z"
        },
        "committer": {
          "name": "GitHub",
          "email": "noreply@github.com",
          "date": "2026-10-31T12:15:41Z"
        },
        "message": "fix: return an inherited /Resources dictionary from get_page_resources (#654)\n\nget_page_resources only returned a /Resources dictionary written into\nthe page itself, and on the ancestors it only followed references. A\npage inheriting a /Resources dictionary written directly into a /Pages\nnode got no resources at all, so get_page_fonts was empty and\nextract_text, replace_text and replace_partial_text could not decode\nits text. Now the nearest /Resources is returned when it is a\ndictionary, whether it is on the page or on an ancestor.",
        "tree": {
          "sha": "9a205268c2438cfa16592ac078ac3be84cfa827e",
          "url": "https://api.github.com/repos/J-F-Liu/lopdf/git/trees/9a205268c2438cfa16592ac078ac3be84cfa827e"
        },
